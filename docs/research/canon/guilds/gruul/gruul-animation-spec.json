    "rage_gold": "#e0a84b",
    "moss": "#566b2f",
    "wild_green": "#879d4b",
    "bone": "#ead8b8",
    "dust": "#b78b5a",
    "glow_ember": "rgba(217, 97, 41, 0.34)",
    "glow_moss": "rgba(135, 157, 75, 0.24)",
    "shadow_stomp": "rgba(4, 2, 1, 0.76)"
  },
  "timing": {
    "spark": "180ms",
    "lunge": "320ms",
    "stomp": "520ms",
    "aftershock": "900ms",
