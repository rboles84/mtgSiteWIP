  "core_axiom": "The body knows before the law finishes speaking.",
  "motion_model": "spark -> stomp -> riot choice -> impact -> aftershock",
  "palette": {
    "ash": "#120d09",
    "bark": "#24160d",
    "charcoal": "#080604",
    "blood": "#8f2416",
