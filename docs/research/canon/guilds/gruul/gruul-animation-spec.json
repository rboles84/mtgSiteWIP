    },
    "maze_link": {
      "hover": "footstep near coals; compression and ember edge",
      "copy_style": "break / charge / trail / impact"
    },
    "error_state": {
      "visual": "cracked surface",
      "motion": "no alarm flash; no long shake",
      "copy": "That path hit stone."
    }
