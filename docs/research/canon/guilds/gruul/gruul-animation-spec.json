    },
    {
      "name": "vm-gruul-ember-lunge",
      "purpose": "short-lived spark/streak motion for attack path"
    },
    {
      "name": "vm-gruul-riot-choice",
      "purpose": "branching speed-or-size interaction"
    },
    {
      "name": "vm-gruul-ground-crack",
      "purpose": "divider/panel reveal as terrain splitting"
    },
    {
      "name": "vm-gruul-aftershock-pulse",
      "purpose": "low-frequency selected-state pulse"
    },
    {
      "name": "vm-gruul-pack-surge",
      "purpose": "chip/card cascade motion"
    }
  ],
  "component_states": {
    "placement_card": {
      "entrance": "vm-gruul-stomp-in",
      "idle_primary": "vm-gruul-aftershock-pulse",
