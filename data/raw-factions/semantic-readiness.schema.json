{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxmana.io/schemas/semantic-readiness.schema.json",
  "title": "Vox Mana Semantic Readiness Additions",
  "type": "object",
  "$defs": {
    "semanticRole": {
      "type": "string",
      "enum": ["substantive_claim", "discovery_record", "support_record", "unclassified"]
    },
    "evidenceLocation": {
      "type": "object",
      "required": ["source_id", "locator_type", "locator", "bounded_paraphrase", "evidence_scope", "interpretation_level"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "locator_type": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "bounded_paraphrase": { "type": "string", "minLength": 1 },
        "evidence_scope": { "type": "string", "minLength": 1 },
        "interpretation_level": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "claimAdditions": {
      "type": "object",
      "properties": {
        "semantic_role": { "$ref": "#/$defs/semanticRole" },
        "evidence_use": {
          "type": "string",
          "enum": ["semantic", "discovery_metadata", "auxiliary_support"]
        },
        "evidence_locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceLocation" }
        }
      },
      "additionalProperties": true
    },
    "guidanceEvidence": {
      "type": "object",
      "required": ["canonical_pointer", "canonical_content_hash", "evidence_claim_ids"],
      "properties": {
        "canonical_pointer": { "type": "string", "pattern": "^/chatbot_guidance/" },
        "canonical_content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "canonical_id": { "type": ["string", "null"] },
        "evidence_claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
