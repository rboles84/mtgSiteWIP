{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxmana.io/schemas/vm551-card-content-review-proposals.source.schema.json",
  "title": "VM-551 Packet 1 card-content automatic adjudication",
  "type": "object",
  "required": [
    "schema_version", "status", "authority_chain", "promotion_rule",
    "candidate_adjudication", "voice_adjudication", "proposals"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "vm551-card-content-approval-packet-v1" },
    "status": { "const": "AUTOMATIC_ADJUDICATION_COMPLETE" },
    "authority_chain": { "type": "string", "minLength": 1 },
    "promotion_rule": { "type": "string", "minLength": 1 },
    "candidate_adjudication": {
      "type": "object",
      "required": ["source", "total", "unresolved"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "total": { "const": 125 },
        "unresolved": { "const": 0 }
      }
    },
    "voice_adjudication": {
      "type": "object",
      "required": ["original_candidates", "replacement_candidates", "review_required", "rejected", "review_identity_coverage", "approved_public", "approved_identity_coverage"],
      "additionalProperties": false,
      "properties": {
        "original_candidates": { "const": 111 },
        "replacement_candidates": { "type": "integer", "minimum": 0 },
        "review_required": { "const": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "review_identity_coverage": { "const": 0 },
        "approved_public": { "const": 37 },
        "approved_identity_coverage": { "const": 37 }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 136,
      "items": {
        "type": "object",
        "required": [
          "proposal_id", "proposal_type", "identity_key", "canonical_card_name",
          "canonical_card_id", "proposed_copy", "copy_sha256", "provenance",
          "limitations", "disposition", "approval_basis", "owner_decision", "replacement_locator"
        ],
        "properties": {
          "proposal_id": { "type": "string", "pattern": "^packet1_(rationale|voice)_[a-z0-9_]+$" },
          "proposal_type": { "enum": ["CARD_RATIONALE", "CARD_VOICE"] },
          "identity_key": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "canonical_card_name": { "type": "string", "minLength": 1 },
          "canonical_card_id": { "type": "string", "minLength": 1 },
          "proposed_copy": { "type": "string", "minLength": 1 },
          "copy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "verified_card_observation": { "type": "string", "minLength": 1 },
          "relationship_class": { "enum": ["EXPLICIT_IDENTITY_REFERENCE", "NATIVE_FIGURE_OR_LOCATION", "CERTIFIED_SEMANTIC_ECHO", "GENERIC_THEMATIC_ANALOGY"] },
          "certified_identity_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "certified_identity_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim_id", "statement"],
              "additionalProperties": false,
              "properties": {
                "claim_id": { "type": "string", "minLength": 1 },
                "statement": { "type": "string", "minLength": 1 }
              }
            }
          },
          "why_voice_belongs": { "type": "string", "minLength": 1 },
          "relationship_bridge": { "type": "string", "minLength": 1 },
          "false_positive_analysis": { "type": "string", "minLength": 1 },
          "adjacent_identity_confusion_risk": { "type": "string", "minLength": 1 },
          "agent_recommendation": { "enum": ["APPROVED_PUBLIC", "REJECTED"] },
          "provenance": { "type": "object" },
          "limitations": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["APPROVED_PUBLIC", "REJECTED"] },
          "approval_basis": { "enum": ["EVIDENCE_VALIDATED_AUTOMATIC", "NOT_APPLICABLE"] },
          "validation": { "type": "object" },
          "owner_decision": { "type": "null" },
          "replacement_locator": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "proposal_type": { "const": "CARD_RATIONALE" } } },
            "then": { "required": ["verified_card_observation"] }
          },
          {
            "if": { "properties": { "proposal_type": { "const": "CARD_VOICE" } } },
            "then": {
              "required": [
                "relationship_class", "certified_identity_claim_ids", "certified_identity_claims",
                "why_voice_belongs", "relationship_bridge", "false_positive_analysis",
                "adjacent_identity_confusion_risk", "agent_recommendation"
              ]
            }
          },
          {
            "if": { "properties": { "disposition": { "const": "APPROVED_PUBLIC" } } },
            "then": { "required": ["validation"] }
          }
        ]
      }
    }
  }
}
