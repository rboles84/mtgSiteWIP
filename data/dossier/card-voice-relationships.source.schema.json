{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxmana.io/schemas/card-voice-relationships.source.schema.json",
  "title": "Vox Mana card-voice relationship authority",
  "type": "object",
  "required": ["schema_version", "authority", "review_policy", "records"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "authority": { "type": "string", "minLength": 1 },
    "review_policy": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "minItems": 37,
      "maxItems": 73,
      "items": {
        "type": "object",
        "required": ["relationship_id", "identity_key", "slot", "pair_role", "canonical_card_name", "canonical_card_id", "scryfall_id", "exact_excerpt", "printing", "relationship_class", "certified_identity_claim_ids", "canonical_card_data_locator", "relationship_bridge", "false_positive_analysis", "adjacent_identity_confusion_risk", "review_status", "approval_basis"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 2 },
          "pair_role": { "enum": ["ANCHOR", "COMPLEMENT"] },
          "review_status": { "enum": ["APPROVED_PUBLIC", "REVIEW_REQUIRED"] },
          "approval_basis": { "enum": ["EVIDENCE_VALIDATED_AUTOMATIC", "OWNER_SEMANTIC_REVIEW_REQUIRED", "OWNER_SEMANTIC_APPROVAL"] },
          "relationship_class": { "enum": ["EXPLICIT_IDENTITY_REFERENCE", "NATIVE_FIGURE_OR_LOCATION", "CERTIFIED_SEMANTIC_ECHO"] },
          "certified_identity_claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true },
          "printing": {
            "type": "object",
            "required": ["scryfall_id", "oracle_id", "set", "collector_number", "flavor_text_field", "source_locator"],
            "properties": {
              "scryfall_id": { "type": "string", "format": "uuid" },
              "oracle_id": { "type": "string", "format": "uuid" },
              "set": { "type": "string", "minLength": 2 },
              "collector_number": { "type": "string", "minLength": 1 },
              "flavor_text_field": { "type": "string", "minLength": 1 },
              "source_locator": { "type": "string", "pattern": "^https://api\\.scryfall\\.com/cards/" }
            },
            "additionalProperties": false
          },
          "validation": { "type": "object", "required": ["validator_version", "passed", "failures"], "properties": { "passed": { "const": true } } },
          "structural_validation": { "type": "object", "required": ["validator_version", "passed", "failures"], "properties": { "passed": { "const": true } } }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": { "properties": { "review_status": { "const": "APPROVED_PUBLIC" } } },
            "then": {
              "required": ["validation"],
              "oneOf": [
                {
                  "properties": {
                    "slot": { "const": 1 },
                    "pair_role": { "const": "ANCHOR" },
                    "approval_basis": { "const": "EVIDENCE_VALIDATED_AUTOMATIC" }
                  }
                },
                {
                  "required": ["structural_validation", "owner_decision", "teaching_facet", "complements_relationship_id", "proposed_modal_explanation", "overlap_review", "public_eligible"],
                  "properties": {
                    "slot": { "const": 2 },
                    "pair_role": { "const": "COMPLEMENT" },
                    "approval_basis": { "const": "OWNER_SEMANTIC_APPROVAL" },
                    "owner_decision": { "const": "APPROVE" },
                    "public_eligible": { "const": true }
                  }
                }
              ]
            }
          },
          {
            "if": { "properties": { "review_status": { "const": "REVIEW_REQUIRED" } } },
            "then": { "required": ["structural_validation", "owner_decision", "teaching_facet", "complements_relationship_id", "proposed_modal_explanation", "overlap_review", "public_eligible"], "properties": { "slot": { "const": 2 }, "pair_role": { "const": "COMPLEMENT" }, "approval_basis": { "const": "OWNER_SEMANTIC_REVIEW_REQUIRED" }, "owner_decision": { "enum": ["APPROVE", null] }, "public_eligible": { "const": false } } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
